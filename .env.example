# ==============================================================================
# Atithi Devo Bhava (अतिथि देवो भवः) - Environment Configuration Template
# ==============================================================================
# Security Notice: NEVER commit actual keys or .env files to source control.
# All sensitive secrets must remain server-side. NEXT_PUBLIC_* variables are
# baked into client bundles and MUST NOT contain secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Infrastructure (Mumbai ap-south-1)
# ------------------------------------------------------------------------------
# Public Supabase Project URL for API and client initialization
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous Key (safe for client-side queries protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Service Role Key (SERVER-ONLY: strictly for backend administration,
# cron routines, and system triggers. NEVER expose to the browser)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Direct Postgres Database Connection URL (for migrations and administrative scripts)
DATABASE_URL="postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres"

# Realtime WebSocket URL (Mumbai)
NEXT_PUBLIC_SUPABASE_REALTIME_URL="wss://your-project-id.supabase.co/realtime/v1"

# ------------------------------------------------------------------------------
# 2. Application and Routing Configuration
# ------------------------------------------------------------------------------
# Canonical base URL for production and local environments
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Default application environment (development | production | test)
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 3. Transactional Messaging and Communications (Server-Side)
# ------------------------------------------------------------------------------
# Resend API Key for transactional emails (OTPs, notifications, alerts)
# When empty in development, DevEmailProvider logs messages locally.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Atithi Devo Bhava <notifications@atithidevobhava.in>"

# Indian DLT-Registered SMS Provider Configuration
# When empty in development, DevSmsProvider logs OTPs locally.
SMS_PROVIDER_API_KEY=""
SMS_PROVIDER_SENDER_ID="ADBIND"
SMS_DLT_OTP_TEMPLATE_ID="110716XXXXXXXXX"

# ------------------------------------------------------------------------------
# 4. Identity Verification and Cloudflare Turnstile Bot Defense
# ------------------------------------------------------------------------------
# Cloudflare Turnstile Site Key (client-side widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# Cloudflare Turnstile Secret Key (server-side verification)
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# ------------------------------------------------------------------------------
# 5. Payment Gateway Configuration (Phase 2 - Gated behind PAYMENTS_ENABLED)
# ------------------------------------------------------------------------------
# Razorpay Key ID and Secret (Server-side order generation and webhook verification)
# When empty in development, DevPaymentProvider is used.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 6. Map and Geographic Visualization
# ------------------------------------------------------------------------------
# MapLibre / OpenStreetMap Tile Endpoint (self-hosted PMTiles or privacy-respecting provider)
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"

# ------------------------------------------------------------------------------
# 7. Encryption at Rest (pgcrypto and field cipher keys)
# ------------------------------------------------------------------------------
# Master encryption key for sensitive PII (contact details, address reveals)
# Must be a 32-byte hex or base64 string.
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
